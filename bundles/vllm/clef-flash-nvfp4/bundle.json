  "api": {"type": "systemone"},
  "defaults": {
    "target_model": {
      "id": "alpha-x-ai/clef-flash-NVFP4",
      "revision": "e676d8e6e14f5ee74830d33fa1fad643d8f53acf"
    },
    "vllm_args": [
      "vllm", "serve", "alpha-x-ai/clef-flash-NVFP4",
