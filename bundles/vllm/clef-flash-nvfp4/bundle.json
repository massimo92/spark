      "--gpu-memory-utilization", "0.12",
      "--max-model-len", "8192",
      "--max-num-seqs", "1",
      "--kv-cache-memory-bytes", "1610612736",
      "--max-num-batched-tokens", "8192",
      "--enforce-eager"
