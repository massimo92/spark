}

workspace_hermes_gateway_proxy_running() {
  docker ps --format '{{.Names}}' 2>/dev/null | grep -qx "$WORKSPACE_HERMES_GATEWAY_PROXY_CONTAINER"
}

workspace_hermes_vikunja_proxy_running() {
