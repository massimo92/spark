    "NEMOCLAW_NON_INTERACTIVE=${NEMOCLAW_NON_INTERACTIVE:-1}"
    "NEMOCLAW_ACCEPT_THIRD_PARTY_SOFTWARE=${NEMOCLAW_ACCEPT_THIRD_PARTY_SOFTWARE:-1}"
