  nemohermes hermes exec --no-tty --timeout 20 -- "$binary" -c '
import sqlite3
import time
import uuid

probe = "spark-doctor-delete-probe-" + uuid.uuid4().hex
conn = sqlite3.connect("/sandbox/.hermes/state.db", isolation_level=None, timeout=5)
conn.execute("PRAGMA foreign_keys=ON")
try:
    conn.execute("BEGIN IMMEDIATE")
    conn.execute(
        "INSERT INTO sessions(id, source, started_at) VALUES (?, ?, ?)",
        (probe, "spark-doctor", time.time()),
