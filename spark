spark_validate_cli_update() {
  local candidate="$1" file="${SPARK_CONFIG_DIR}/litellm-image"
  bash -n "$candidate" || return 1
  spark_load_litellm_image_pin || return 1
  if [[ -e "$file" || -L "$file" ]]; then
    # Older releases must not silently discard a configured pin on replacement.
    if ! grep -Fxq 'spark_load_litellm_image_pin || { return 1 2>/dev/null || exit 1; }' "$candidate"; then
      printf 'Update refused: downloaded Spark does not support the LiteLLM image pin in %s\n' "$file" >&2
      return 1
    fi
  fi
}

