import sys
sys.path.insert(0, "/sandbox/.hermes/plugins/web-spark-ddgs/vendor")
from ddgs import DDGS
results = DDGS(timeout=10).text(
    "Spark web search readiness",
    max_results=1,
    backend="duckduckgo",
)
raise SystemExit(0 if results else 1)
