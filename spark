hf_cache_first_unwritable() {
  local dir="${1:-$HF_CACHE_DIR}" p
  [[ -e "$dir" ]] || return 1
  if [[ ! -w "$dir" ]]; then
    printf '%s\n' "$dir"
    return 0
  fi
  while IFS= read -r -d '' p; do
    if [[ ! -w "$p" ]]; then
      printf '%s\n' "$p"
      return 0
    fi
  done < <(find "$dir" -mindepth 1 -print0 2>/dev/null)
  return 1
}

