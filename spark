  case "$p" in
    openai|xai|anthropic|chatgpt|github_copilot)
      if [[ ${#names[@]} == 0 ]]; then
        printf '  Model ID (available in your account): ' >&2; IFS= read -r model || return 1
        [[ -n "$model" ]] || return 1; names+=("$model")
      fi ;;
  esac
  models_json=$(printf '%s\n' "$old" | jq -c --arg p "$p" '.providers[$p].models // []') || return 1
  for model in ${names[@]+"${names[@]}"}; do
    [[ "$model" != *$'\n'* && "$model" != *$'\r'* && "$model" != '*' && "$model" != */'*' ]] || return 1
    models_json=$(printf '%s\n' "$models_json" | jq --arg model "${model#"$p"/}" '. + [$model] | unique') || return 1
  done
  config=$(printf '%s\n' "$config" | jq --arg p "$p" --arg auth "$mode" --argjson models "$models_json" '.providers[$p]={enabled:true,auth:$auth,models:$models}') || return 1
  gateway_save_config "$config" || return 1
  if gateway_running_state && ! gateway_sync_locked; then gateway_save_config "$old"; return 1; fi
  info "Enabled ${p} (${mode}); start with spark gateway start"
}
gateway_remove() { gateway_with_lock gateway_remove_locked "$@"; }
gateway_remove_locked() {
  local p="${1:-}" old config
  gateway_provider_valid "$p" && [[ "$p" != vllm ]] || { err 'Cannot remove this provider'; return 1; }
  old=$(gateway_load_config)
  config=$(printf '%s\n' "$old" | jq --arg p "$p" '.providers[$p].enabled=false') || return 1
  gateway_save_config "$config" || return 1
  if gateway_running_state && ! gateway_sync_locked; then gateway_save_config "$old"; return 1; fi
  info "Disabled ${p}"
}
gateway_status() {
  local config state=stopped
  config=$(gateway_load_config)
  gateway_api_ready && state=ready || { gateway_running_state && state=not-ready || true; }
  printf 'LiteLLM: %s\nAPI: http://localhost:%s/v1\n' "$state" "$(gateway_configured_port)"
  printf 'Authentication: %s\n' "$(gateway_auth_ready && printf configured || printf migration-required)"
  printf '%s\n' "$config" | jq -r '.providers // {} | to_entries[] | select(.value.enabled) | "Provider: \(.key) (\(.value.auth // "local"))"'
  local p
  for p in chatgpt github_copilot xai; do
    if gateway_provider_enabled "$p" | grep -qx true && { [[ "$p" != xai ]] || [[ "$(printf '%s\n' "$config" | jq -r '.providers.xai.auth')" == oauth ]]; }; then printf '%s OAuth: %s\n' "$p" "$(gateway_oauth_status "$p")"; fi
  done
  gateway_access_status
}
cmd_gateway() {
  local cmd="${1:-help}"; [[ $# == 0 ]] || shift
  case "$cmd" in
    setup) gateway_setup_local "$@" ;; start) gateway_start ;; stop) gateway_with_lock gateway_stop ;; status) gateway_status ;; logs) gateway_logs "$@" ;;
    add) gateway_add "$@" ;; remove) gateway_remove "$@" ;; auth) gateway_auth_command "$@" ;;
    login) gateway_with_lock gateway_login "$@" ;; import-session) gateway_with_lock gateway_import_session "$@" ;; logout) gateway_with_lock gateway_logout "$@" ;;
    capabilities) gateway_capabilities "${1:-base}" "$(gateway_runtime_image)" ;; access) gateway_access_command "$@" ;;
    help|--help|-h)
      cat <<'HELP'
Usage: spark gateway <setup|start|stop|status|logs|add|remove|auth|login|logout|capabilities|access>
  setup [--yes]             Configure local providers, authentication and access
  auth status                Check authentication configuration
  auth rotate                Replace the inference token (shown once)
  login PROVIDER [--remote USER@HOST]
                             OAuth login on this computer, optionally install remotely
  logout PROVIDER            Disable the provider and remove its session
  add PROVIDER [--auth api|oauth] [--model ID ...]
                             openai, chatgpt, github_copilot, xai, anthropic,
                             openrouter, ollama, zen, together
  capabilities [PROVIDER]    Inspect installed LiteLLM version/login capability
  access nodes|allow|policy|enable|disable|status|protect|probe|verify
                             HTTPS access and Tailscale policy workflow
Provider API keys are read with hidden input; subscriptions use a separate login.
New gateway tokens appear once in an interactive terminal; save them immediately.
Stored tokens cannot be displayed by the CLI. Lost token? Use auth rotate.
Claude Pro/Max is not offered as a general gateway API.
HELP
      ;;
    *) err "Unknown gateway command: $cmd"; return 1 ;;
  esac
}

# Validate the proposed configuration before interrupting a working proxy.
gateway_preflight() {
  local config p mode env_key key name rest
  config=$(gateway_load_config) || return 1
  gateway_capabilities keys >/dev/null || { err 'LiteLLM image lacks PostgreSQL virtual-key support'; return 1; }
  printf '%s\n' "$config" | jq -e '.port // 4000 | type=="number" and .>0 and .<=65535' >/dev/null || return 1
  if [[ "$(gateway_provider_enabled vllm)" == true ]]; then
    while IFS=$'\t' read -r name rest; do
      [[ -n "$name" ]] || continue
      if [[ "$(model_api_kind "$name")" == systemone ]]; then
        systemone_gateway_preflight || return 1
        break
      fi
    done < <(list_managed_containers)
  fi
  for p in openrouter zen together openai anthropic xai chatgpt github_copilot; do
    [[ "$(gateway_provider_enabled "$p")" == true ]] || continue
    mode=$(printf '%s\n' "$config" | jq -r --arg p "$p" '.providers[$p].auth // (if $p=="chatgpt" or $p=="github_copilot" then "oauth" else "api" end)')
    if [[ "$mode" == oauth ]]; then
      gateway_capabilities "$p" >/dev/null && [[ "$(gateway_oauth_status "$p")" == credentials-present ]] || { err "Provider ${p} requires supported login: spark gateway login ${p}"; return 1; }
    else
      env_key=$(gateway_provider_env "$p") || return 1
      key=$(gateway_env_get "$env_key" 2>/dev/null || true)
      [[ -n "$key" ]] || { err "Provider ${p} needs an API key: spark gateway add ${p}"; return 1; }
    fi
  done
}
gateway_register_ollama() { gateway_with_lock gateway_register_ollama_locked "$@"; }
gateway_register_ollama_locked() {
  local config
  config=$(gateway_load_config) || return 1
  gateway_save_config "$(printf '%s\n' "$config" | jq --arg m "$1" '.providers.ollama.enabled=true | .providers.ollama.models=((.providers.ollama.models // []) + [$m] | unique)')"
}
gateway_forget_ollama() { gateway_with_lock gateway_forget_ollama_locked "$@"; }
gateway_forget_ollama_locked() {
  gateway_configured || return 0
  local target="$1" loaded="$2" config
  [[ -n "$target" ]] || target="$loaded"
  config=$(gateway_load_config) || return 1
  if [[ "$target" == --all ]]; then
    config=$(printf '%s\n' "$config" | jq '.providers.ollama.models=[]') || return 1
  else
    config=$(printf '%s\n' "$config" | jq --arg m "$target" '.providers.ollama.models=((.providers.ollama.models // []) | map(select(.!=$m)))') || return 1
  fi
  gateway_save_config "$config"
}
gateway_route_smoke() {
  local provider="$1" model="$2" id payload out prefix
  prefix=$(gateway_model_prefix "$provider" "$model") || return 1
  id="$prefix/$model"
  if [[ "$prefix" == systemone ]]; then
    payload=$(jq -nc --arg id "$id" '{model:$id,state:"Spark gateway routing check",questions:{ready:{type:"noul",instructions:"Is this a gateway routing check?"}}}') || return 1
    out=$(gateway_curl -fsS --max-time "${SPARK_GATEWAY_SMOKE_TIMEOUT:-60}" -H 'Content-Type: application/json' --data "$payload" "http://127.0.0.1:$(gateway_configured_port)/v1/systemone" 2>/dev/null) || return 1
    printf '%s\n' "$out" | jq -e '.answers.ready.noul | type=="number" and .>=0 and .<=1' >/dev/null
    return $?
  fi
  payload=$(jq -nc --arg id "$id" '{model:$id,messages:[{role:"user",content:"Reply OK"}],max_tokens:1,stream:false}') || return 1
  out=$(gateway_curl -fsS --max-time "${SPARK_GATEWAY_SMOKE_TIMEOUT:-60}" -H 'Content-Type: application/json' --data "$payload" "http://127.0.0.1:$(gateway_configured_port)/v1/chat/completions" 2>/dev/null) || return 1
  printf '%s\n' "$out" | jq -e '(.choices | type)=="array" and (.choices|length)>0' >/dev/null
}
gateway_setup_local() {
  local auto=0 p mode nodes
  [[ $# == 0 ]] || { [[ $# == 1 && "$1" == --yes ]] || return 1; auto=1; }
  gateway_prepare_runtime "$BACKEND" || return 1
  # Adopt existing Ollama models on first migration; preserve an explicit registry.
  if [[ "$BACKEND" == ollama ]] && ! gateway_load_config | jq -e '.providers.ollama | has("models")' >/dev/null; then
    while IFS= read -r p; do [[ -z "$p" ]] || gateway_register_ollama "$p" || return 1; done < <(ollama ps 2>/dev/null | awk 'NR>1{print $1}')
  fi
  if [[ "$auto" == 0 ]]; then
    printf 'API accounts and subscriptions use separate credentials. Models depend on your account.\n'
    for p in openai chatgpt github_copilot xai anthropic openrouter zen together; do
      mode=api
      case "$p" in
        chatgpt|github_copilot) mode=oauth ;;
        xai) if confirm 'Use xAI / SuperGrok subscription login instead of an API key?'; then mode=oauth; fi ;;
      esac
      confirm "Configure ${p} (${mode})?" || continue
      if [[ "$mode" == oauth && "$(gateway_oauth_status "$p")" != credentials-present ]]; then gateway_with_lock gateway_login "$p" || return 1; fi
      gateway_add "$p" --auth "$mode" || return 1
    done
  fi
  gateway_start || return 1
  gateway_status
  if [[ "$auto" == 0 ]] && confirm 'Select Tailscale nodes for private HTTPS access?'; then
    gateway_access_nodes || return 1
    printf 'Node names/IPs (space separated): ' >&2; IFS= read -r nodes || return 1
    local selected=()
    read -ra selected <<< "$nodes"
    gateway_with_lock gateway_access_allow ${selected[@]+"${selected[@]}"} || return 1
    printf 'Apply the generated policy, then: spark gateway access enable\n'
  fi
}

gateway_managed_client_endpoint() {
  case "$1" in
    ''|"http://127.0.0.1:$(gateway_configured_port)/v1"|"http://localhost:$(gateway_configured_port)/v1"|"http://host.openshell.internal:$(gateway_configured_port)/v1") return 0 ;;
    *) return 1 ;;
  esac
}

gateway_runtime_image() {
  local image=''
  if gateway_running_state; then image=$(docker inspect "$GATEWAY_CONTAINER" --format '{{.Image}}' 2>/dev/null || true); fi
  printf '%s\n' "${image:-$LITELLM_IMAGE}"
}
gateway_provider_status_json() {
  local providers='{}' p mode session entry
  while IFS=$'\t' read -r p mode; do
    [[ -n "$p" ]] || continue
    session=not-applicable
    [[ "$mode" != oauth ]] || session=$(gateway_oauth_status "$p") || return 1
    entry=$(jq -nc --arg auth "$mode" --arg session "$session" '{enabled:true,auth:$auth,session:$session}') || return 1
    providers=$(printf '%s\n' "$providers" | jq -c --arg p "$p" --argjson entry "$entry" '.[$p]=$entry') || return 1
  done < <(gateway_load_config | jq -r '.providers // {} | to_entries[] | select(.value.enabled) | [.key,(.value.auth // "local")] | @tsv')
  printf '%s\n' "$providers"
}

# Delete only Spark-owned recovery files after authenticated runtime/client checks.
gateway_migration_cleanup() {
  local backup="$SPARK_CONFIG_DIR/gateway-migration"
  [[ -d "$backup" && ! -L "$backup" ]] || return 0
  rm -f "$backup/gateway.json" "$backup/gateway.env" "$backup/litellm_config.yaml" || return 1
  rmdir "$backup" || { err 'Recovery folder contains unexpected files; inspect it manually'; return 1; }
}
gateway_migration_restore_config() {
  local backup="$SPARK_CONFIG_DIR/gateway-migration/gateway.json" restored p key env_key
  [[ -f "$backup" ]] || return 0
  restored=$(jq '.' "$backup") || return 1
  for p in openrouter zen together openai xai anthropic; do
    key=$(printf '%s\n' "$restored" | jq -r --arg p "$p" '.providers[$p].api_key // ""') || return 1
    if [[ -n "$key" ]]; then
      env_key=$(gateway_provider_env "$p") || return 1
      gateway_env_set "$env_key" "$key" || return 1
    fi
  done
  restored=$(printf '%s\n' "$restored" | jq 'if .providers then del(.providers[].api_key) else . end') || return 1
  gateway_save_config "$restored"
}
# Based on spark by Massimo Angelini - https://github.com/massimo92/spark
# Serve exposes a service; only the tailnet policy restricts source nodes.
gateway_access_status() {
  local config dns port state
  config=$(gateway_load_config)
  port=$(printf '%s\n' "$config" | jq -r '.access.port // 443')
  state=$(printf '%s\n' "$config" | jq -r 'if .access.enabled and .access.port!=443 then "migration-required" elif .access.enabled then (if .access.policy_status=="verified" then "verified" else "policy-verification-pending" end) else "local-only" end')
  printf 'Private access: %s\n' "$state"
  if [[ "$state" != local-only ]] && command -v tailscale >/dev/null 2>&1; then
    dns=$(tailscale status --json 2>/dev/null | jq -r '.Self.DNSName // "" | rtrimstr(".")')
    [[ -z "$dns" ]] || printf 'Private API: https://%s%s/v1\n' "$dns" "$([[ "$port" == 443 ]] || printf ':%s' "$port")"
  fi
}
gateway_access_nodes() {
  tailscale status --json | jq -r '([.Self] + [.Peer[]?])[] | [.HostName,.DNSName,(.TailscaleIPs|join(",")),(.Online|tostring)] | @tsv'
}
gateway_access_allow() {
  local ssh_port
  ssh_port=$(gateway_access_ssh_port) || return 1
  while [[ $# -gt 0 ]]; do
    case "$1" in
      --port) [[ $# -ge 2 && "$2" == 443 ]] || { err 'The private API uses HTTPS port 443 only'; return 1; }; shift 2 ;;
      --ssh-port) [[ $# -ge 2 ]] || return 1; ssh_port="$2"; shift 2 ;;
      *) break ;;
    esac
  done
  [[ "$ssh_port" =~ ^[0-9]+$ && "$ssh_port" -ge 1 && "$ssh_port" -le 65535 && "$ssh_port" != 443 ]] || return 1
  [[ $# -gt 0 ]] || { err 'Usage: spark gateway access allow [--ssh-port 22] <node-name|IP> ...'; return 1; }
  local status selector matches count ips='[]' names_json='[]' config
  status=$(tailscale status --json) || return 1
  for selector in "$@"; do
    matches=$(printf '%s\n' "$status" | jq --arg s "$selector" '[([.Self] + [.Peer[]?])[] | select(.HostName==$s or ((.DNSName // "")|rtrimstr("."))==$s or ((.DNSName // "")|split(".")[0])==$s or any(.TailscaleIPs[]?; .==$s))]') || return 1
    count=$(printf '%s\n' "$matches" | jq length)
    [[ "$count" == 1 ]] || { err "Node must resolve uniquely: ${selector}"; return 1; }
    ips=$(jq -nc --argjson a "$ips" --argjson m "$matches" '$a + $m[0].TailscaleIPs | unique') || return 1
    names_json=$(printf '%s\n' "$names_json" | jq --arg name "$selector" '. + [$name]') || return 1
  done
  config=$(gateway_load_config)
  config=$(printf '%s\n' "$config" | jq --argjson ips "$ips" --argjson names "$names_json" --argjson ssh "$ssh_port" '
    if .access.port!=null and .access.port!=443 then .access.enabled=false else . end |
    .access.port=443 | .access.ssh_port=$ssh | .access.sources=$ips | .access.nodes=$names |
    .access.policy_status="pending" | del(.access.verified_at)') || return 1
  gateway_save_config "$config" || return 1
  info 'Selected source nodes; apply the grants fragment in Tailscale before enabling access'
  gateway_access_policy
}
gateway_access_policy() {
  local status config addresses sources ssh_port blocked output
  status=$(tailscale status --json) || return 1
  config=$(gateway_load_config) || return 1
  addresses=$(printf '%s\n' "$status" | jq -c '.Self.TailscaleIPs') || return 1
  sources=$(printf '%s\n' "$config" | jq -c '.access.sources // []') || return 1
  [[ "$(printf '%s\n' "$sources" | jq length)" -gt 0 ]] || { err 'Select nodes with spark gateway access allow first'; return 1; }
  ssh_port=$(gateway_access_ssh_port) || return 1
  blocked=$(gateway_access_blocked_ports) || return 1
  output=$(jq -n --argjson src "$sources" --argjson dst "$addresses" --argjson ssh "$ssh_port" --argjson blocked "$blocked" --argjson status "$status" '
    def host: if contains(":") then "["+.+"]" else . end;
    def destinations($ports): [$dst[] | host as $h | $ports[] | $h+":"+(.|tostring)];
    {grants:[{src:$src,dst:$dst,ip:["tcp:443"]},{src:$src,dst:$dst,ip:["tcp:"+($ssh|tostring)]}],
     tests:([$src[] | {src:.,proto:"tcp",accept:destinations([443,$ssh]),deny:destinations($blocked)}] +
            [$src[] | {src:.,proto:"udp",deny:destinations(($blocked+[443,$ssh])|unique)}] +
            [$status.Peer[]?.TailscaleIPs[] | select(. as $ip | $src | index($ip) | not) | {src:.,proto:"tcp",deny:destinations([443])}])}') || return 1
  printf '%s\n' "$output"
  printf 'Merge these grants and tests in the tailnet admin policy. Keep administrative SSH/key authentication. Remove overlapping broad API grants for these clients: only TCP/443 (LiteLLM) and TCP/%s (SSH) should remain reachable on this node. Other administrators keep their SSH rules. Tests cover both IP families and current/common service ports; refresh after adding listeners or replacing a node.\n' "$ssh_port" >&2
}
gateway_access_enable() {
  local config status dns serve key target current port
  [[ $# == 0 || ( $# == 2 && "$1" == --port && "$2" == 443 ) ]] || { err 'The private API uses HTTPS port 443 only'; return 1; }
  gateway_auth_ready && gateway_wait_ready || { err 'Start an authenticated gateway first'; return 1; }
  config=$(gateway_load_config) || return 1
  tailscale_funnel_status_active && { err 'Funnel active; resolve public exposure before enabling private gateway access'; return 1; }
  status=$(tailscale status --json) || return 1
  dns=$(printf '%s\n' "$status" | jq -r '.Self.DNSName // "" | rtrimstr(".")')
  [[ -n "$dns" ]] || return 1
  key="$dns:443"; target="http://127.0.0.1:$(gateway_configured_port)"
  serve=$(tailscale serve status --json) || return 1
  if ! printf '%s\n' "$serve" | jq -e --arg key "$key" '(.TCP["443"]==null and .Web[$key]==null)' >/dev/null; then
    printf '%s\n' "$serve" | jq -e --arg key "$key" '.TCP["443"].HTTPS==true and ((.Web[$key].Handlers // {})|keys)==["/"]' >/dev/null || { err 'Port 443 has another handler or TCP service; no services changed'; return 1; }
    current=$(printf '%s\n' "$serve" | jq -r --arg key "$key" '.Web[$key].Handlers["/"].Proxy // ""')
    gateway_access_owned_target "$current" || { err 'Port 443 belongs to another service; no services changed'; return 1; }
  fi
  tailscale serve --bg --https=443 "$target" || return 1
  tailscale_funnel_status_active && { tailscale serve --https=443 off; err 'Public exposure detected'; return 1; }
  config=$(printf '%s\n' "$config" | jq --argjson ssh "$(gateway_access_ssh_port)" '.access.enabled=true | .access.port=443 | .access.ssh_port=$ssh | .protected=true | .access.policy_status="pending" | del(.access.verified_at)') || return 1
  gateway_save_config "$config" || return 1
  gateway_access_https_ready "$dns" || { err 'HTTPS 443 not ready; authenticated target kept, policy verification pending'; return 1; }
  # Retire only Spark API/backends on this hostname; never reset Serve or touch SSH.
  gateway_access_remove_direct "$dns" "$serve" || return 1
  info 'Node access follows your Tailscale ACL/grants; Spark does not change the tailnet policy'
  gateway_access_status
}
gateway_access_disable() {
  local config port status dns key
  config=$(gateway_load_config); port=$(printf '%s\n' "$config" | jq -r '.access.port // 443')
  status=$(tailscale status --json) || return 1
  dns=$(printf '%s\n' "$status" | jq -r '.Self.DNSName | rtrimstr(".")'); key="$dns:$port"
  # Only remove the exact root handler owned by Spark, never reset all Serve.
  tailscale serve status --json | jq -e --arg key "$key" --arg target "http://127.0.0.1:$(gateway_configured_port)" '(.Web[$key].Handlers // {}) | keys==["/"] and .["/"].Proxy==$target' >/dev/null || { err 'Serve entry absent or owned by another service'; return 1; }
  tailscale serve --https="$port" off || return 1
  gateway_save_config "$(printf '%s\n' "$config" | jq '.access.enabled=false')"
}
gateway_access_protect() {
  local config status dns
  config=$(gateway_load_config)
  gateway_wait_ready && [[ "$(printf '%s\n' "$config" | jq -r '.access.enabled and (.access.policy_status=="verified")')" == true ]] || { err 'Verify private gateway access before removing legacy direct Serve routes'; return 1; }
  gateway_save_config "$(printf '%s\n' "$config" | jq '.protected=true')" || return 1
  status=$(tailscale status --json) || return 1
  dns=$(printf '%s\n' "$status" | jq -r '.Self.DNSName // "" | rtrimstr(".")')
  gateway_access_remove_direct "$dns" "$(tailscale serve status --json)" || return 1
  local findings
  findings=$(gateway_exposure_findings)
  if [[ -n "$findings" ]]; then
    err 'Existing inference listeners still accept non-local connections; restart those model aliases to apply localhost binding'
    printf '%s\n' "$findings" >&2; return 1
  fi
  printf 'Inference APIs are local; node clients use HTTPS/443. Administrative SSH is unchanged.\n'

}
gateway_access_probe() {
  local url="${1:-}" kind="${2:-allowed}" key code
  [[ "$url" == https://* && "$url" != *$'\n'* ]] || return 1
  case "$kind" in
    denied)
      # Any HTTP response proves network reachability, including a 401.
      if curl -sS --connect-timeout 3 --max-time 5 -o /dev/null "$url/models"; then
        err 'Denied-node test failed: endpoint reachable'; return 1
      fi
      printf 'Network probe: unreachable (also check node connectivity; this alone does not prove the policy)\n' ;;
    allowed)
      local token_file="${SPARK_GATEWAY_TOKEN_FILE:-$(gateway_secrets_path)}"
      key=$(gateway_env_get LITELLM_API_KEY "$token_file" 2>/dev/null || gateway_env_get LITELLM_MASTER_KEY "$token_file") || { err 'Set SPARK_GATEWAY_TOKEN_FILE to a private client env file containing LITELLM_API_KEY'; return 1; }
      [[ "$key" =~ ^sk-[a-f0-9]{64}$ ]] || return 1
      code=$(curl -sS --max-time 5 -o /dev/null -w '%{http_code}' "$url/models") || return 1
      [[ "$code" == 401 || "$code" == 403 ]] || { err 'Anonymous access accepted'; return 1; }
      code=$(printf 'header = "Authorization: Bearer sk-invalid"\n' | curl --config - -sS --max-time 5 -o /dev/null -w '%{http_code}' "$url/models") || return 1
      [[ "$code" == 401 || "$code" == 403 ]] || return 1
      printf 'header = "Authorization: Bearer %s"\n' "$key" | curl --config - -fsS --max-time 5 -o /dev/null "$url/models" || return 1
      printf 'Allowed-node probe passed: token required and accepted\n' ;;
    *) return 1 ;;
  esac
}
gateway_access_command() {
  local sub="${1:-status}"; [[ $# == 0 ]] || shift
  case "$sub" in
    nodes) gateway_access_nodes ;; status) gateway_access_status ;;
    allow) gateway_with_lock gateway_access_allow "$@" ;; policy) gateway_access_policy ;;
    enable) gateway_with_lock gateway_access_enable "$@" ;; disable) gateway_with_lock gateway_access_disable ;;
    protect) gateway_with_lock gateway_access_protect ;; probe) gateway_access_probe "$@" ;; verify) gateway_with_lock gateway_access_verify "$@" ;;
    *) err 'Usage: spark gateway access <nodes|allow NODE...|policy|enable [--port 443]|disable|status|protect|probe URL [allowed|denied]|verify --allowed NODE --denied NODE>'; return 1 ;;
  esac
}

gateway_access_json() {
  gateway_load_config | jq -c '{enabled:(.access.enabled // false),port:(.access.port // 443),ssh_port:(.access.ssh_port // 22),policy_status:(.access.policy_status // "not-configured"),verified_at:(.access.verified_at // null),nodes:(.access.nodes // []),protected:(.protected != false)}'
}
# Read-only evidence; configuration alone does not prove backend isolation.
gateway_exposure_findings() {
  local name model port rest listeners serve
  command -v ss >/dev/null 2>&1 || return 0
  listeners=$(ss -H -lnt 2>/dev/null) || return 0
  serve=$(tailscale serve status --json 2>/dev/null || printf '{}')
  while IFS=$'\t' read -r _name model port rest; do
    [[ -n "$port" ]] || continue
    if printf '%s\n' "$listeners" | awk -v port="$port" '$4 ~ ("^(0\\.0\\.0\\.0|\\*|\\[::\\]|::):" port "$") {found=1} END{exit !found}'; then
      printf 'Backend %s listens on all interfaces (%s)\n' "$model" "$port"
    fi
    if printf '%s\n' "$serve" | jq -e --arg a "http://127.0.0.1:$port" --arg b "http://localhost:$port" '[.Web[]?.Handlers[]?.Proxy | select(.==$a or .==$b)] | length>0' >/dev/null; then
      printf 'Tailscale Serve publishes backend %s directly (%s)\n' "$model" "$port"
    fi
  done < <(list_managed_containers)
}

# SSH probes establish evidence from two live nodes without storing the token there.
gateway_access_verify() (
  local allowed='' denied='' config status dns port key mode node selector matches ips selected script quoted payload blocked addresses ssh_port
  while [[ $# -gt 0 ]]; do
    case "$1" in
      --allowed) [[ $# -ge 2 ]] || return 1; allowed="$2"; shift 2 ;;
      --denied) [[ $# -ge 2 ]] || return 1; denied="$2"; shift 2 ;;
      *) return 1 ;;
    esac
  done
  [[ -n "$allowed" && -n "$denied" && "$allowed" != "$denied" ]] || { err 'Usage: spark gateway access verify --allowed [user@]NODE --denied [user@]NODE (SSH and Python 3 required)'; return 1; }
  config=$(gateway_load_config) || return 1
  [[ "$(printf '%s\n' "$config" | jq -r '.access.enabled // false')" == true ]] || return 1
  config=$(printf '%s\n' "$config" | jq '.access.policy_status="pending" | del(.access.verified_at)') || return 1
  gateway_save_config "$config" || return 1
  gateway_wait_ready || return 1
  [[ "$(printf '%s\n' "$config" | jq -r '.access.port // 443')" == 443 ]] || { err 'Migrate the private API to HTTPS/443 first'; return 1; }
  status=$(tailscale status --json) || return 1
  dns=$(printf '%s\n' "$status" | jq -r '.Self.DNSName | rtrimstr(".")')
  port=$(printf '%s\n' "$config" | jq -r '.access.port // 443')
  key="sk-$(openssl rand -hex 32)" || return 1
  gateway_virtual_create spark-managed "$key" 5m || return 1
  local probe_hash
  probe_hash=$(gateway_key_hash "$key") || return 1
  # Capture the validated hash before local function scope unwinds at EXIT.
  # shellcheck disable=SC2064
  trap "printf '%s' '{\"keys\":[\"$probe_hash\"]}' | gateway_admin_post /key/delete >/dev/null 2>&1 || true" EXIT
  blocked=$(gateway_access_blocked_ports) || return 1
  addresses=$(printf '%s\n' "$status" | jq -c '.Self.TailscaleIPs // []') || return 1
  [[ "$(printf '%s\n' "$addresses" | jq length)" -gt 0 ]] || return 1
  ssh_port=$(gateway_access_ssh_port) || return 1
  script=$(cat <<'PY'
import json, socket, ssl, sys, urllib.request, urllib.error, urllib.parse
p=json.load(sys.stdin)
u=p['url']+'/models'
# Distinguish unresolved DNS from policy evidence.
socket.getaddrinfo(urllib.parse.urlparse(u).hostname, None)
def status(token=None):
    headers={} if token is None else {'Authorization':'Bearer '+token}
    try:
        with urllib.request.urlopen(urllib.request.Request(u,headers=headers),timeout=5) as r:
            return r.status
    except urllib.error.HTTPError as e: return e.code
if p['mode']=='allowed':
    assert status() in (401,403), 'anonymous access accepted'
    assert status('sk-invalid') in (401,403), 'invalid token accepted'
    assert status(p['token'])==200, 'valid token rejected'
    # A reachable backend or other application would bypass the single API entry.
    for address in p['addresses']:
        for port in p['blocked_ports']:
            try:
                connection=socket.create_connection((address,port),timeout=1)
            except OSError:
                continue
            connection.close()
            raise RuntimeError('Direct application port is reachable: '+str(port))
else:
    for address in p['addresses']:
        try:
            connection=socket.create_connection((address,443),timeout=3)
        except OSError:
            continue
        connection.close()
        raise RuntimeError('denied node can connect to HTTPS/443')
print(p['mode']+' node probe passed')
PY
  ) || return 1
  # POSIX single quoting, including any literal single quotes in the Python source.
  quoted="'${script//\'/\'\\\'\'}'"
  for mode in allowed denied; do
    [[ "$mode" == allowed ]] && node="$allowed" || node="$denied"
    selector="${node##*@}"
    [[ "$node" != -* && "$node" != *$'\n'* && "$node" != *$'\r'* ]] || return 1
    matches=$(printf '%s\n' "$status" | jq --arg s "$selector" '[.Peer[]? | select(.HostName==$s or ((.DNSName // "")|rtrimstr("."))==$s or any(.TailscaleIPs[]?; .==$s))]') || return 1
    [[ "$(printf '%s\n' "$matches" | jq length)" == 1 ]] || { err "Probe node must resolve uniquely: $selector"; return 1; }
    ips=$(printf '%s\n' "$matches" | jq -c '.[0].TailscaleIPs')
    selected=$(printf '%s\n' "$config" | jq -r --argjson ips "$ips" 'any(.access.sources[]; . as $s | $ips | index($s)!=null)')
    [[ "$mode" == allowed && "$selected" == true || "$mode" == denied && "$selected" == false ]] || { err 'Probe nodes do not match the selected policy'; return 1; }
    payload=$(jq -nc --arg url "https://$dns/v1" --arg mode "$mode" --argjson blocked "$blocked" --argjson addresses "$addresses" '{url:$url,mode:$mode,blocked_ports:$blocked,addresses:$addresses}') || return 1
    if [[ "$mode" == allowed ]]; then payload="${payload%\}},\"token\":\"${key}\"}"; fi
    printf '%s\n' "$payload" | ssh -o BatchMode=yes -o ClearAllForwardings=yes -o ForwardAgent=no -o ConnectTimeout=5 "$node" "python3 -c $quoted" || { err "${mode} node verification failed; policy remains pending"; return 1; }
  done
  config=$(printf '%s\n' "$config" | jq --arg now "$(date -u +%Y-%m-%dT%H:%M:%SZ)" '.access.policy_status="verified" | .access.verified_at=$now') || return 1
  gateway_save_config "$config" && gateway_access_status
)

gateway_access_ssh_port() {
  local port
  port=$(gateway_load_config | jq -r '.access.ssh_port // ""') || return 1
  if [[ -z "$port" && -n "${SSH_CONNECTION:-}" ]]; then port="${SSH_CONNECTION##* }"; fi
  port="${port:-22}"
  [[ "$port" =~ ^[0-9]+$ && "$port" -ge 1 && "$port" -le 65535 && "$port" != 443 ]] || return 1
  printf '%s\n' "$port"
}
gateway_access_blocked_ports() {
  local ssh_port
  ssh_port=$(gateway_access_ssh_port) || return 1
  {
    printf '%s\n' 80 4000 8000 8001 8443 11434 3456 5678 8787 18789
    gateway_configured_port
    list_managed_containers 2>/dev/null | awk -F '\t' '{print $3}' || true
    tailscale serve status --json 2>/dev/null | jq -r '.TCP // {} | keys[]' || true
    if command -v ss >/dev/null 2>&1; then ss -H -lnt 2>/dev/null | awk '{n=$4;sub(/^.*:/,"",n);print n}' || true; fi
  } | jq -Rn --argjson ssh "$ssh_port" '[inputs|tonumber? | select(.>=1 and .<=65535 and .!=443 and .!=$ssh)]|unique'
}
gateway_access_owned_target() {
  local target="${1%/}" name model port rest
  [[ "$target" != "http://127.0.0.1:$(gateway_configured_port)" && "$target" != "http://localhost:$(gateway_configured_port)" && "$target" != http://127.0.0.1:11434 && "$target" != http://localhost:11434 ]] || return 0
  while IFS=$'\t' read -r name model port rest; do
    [[ "$port" =~ ^[0-9]+$ ]] || continue
    [[ "$target" != "http://127.0.0.1:$port" && "$target" != "http://localhost:$port" ]] || return 0
  done < <(list_managed_containers)
  return 1
}
gateway_access_remove_direct() {
  local dns="$1" serve="$2" entry port target ssh_port
  ssh_port=$(gateway_access_ssh_port) || return 1
  while IFS= read -r entry; do
    port=$(printf '%s\n' "$entry" | jq -r '.port')
    target=$(printf '%s\n' "$entry" | jq -r '.target // ""')
    [[ "$port" =~ ^[0-9]+$ && "$port" != 443 && "$port" != "$ssh_port" ]] || continue
    if gateway_access_owned_target "$target"; then tailscale serve --https="$port" off || return 1; fi
  done < <(printf '%s\n' "$serve" | jq -c --arg dns "$dns" '.Web // {} | to_entries[] | select(.key|startswith($dns+":")) | select((.value.Handlers // {}|keys)==["/"]) | {port:(.key|split(":")|last),target:.value.Handlers["/"].Proxy}')
}
gateway_access_https_ready() {
  local dns="$1" attempt
  for ((attempt=0; attempt<5; attempt++)); do
    gateway_curl -fsS --connect-timeout 2 --max-time 5 "https://$dns/v1/models" >/dev/null 2>&1 && return 0
    sleep 1
  done
  return 1
}
# Based on spark by Massimo Angelini - https://github.com/massimo92/spark
# Native OAuth beside the browser; session transfer uses ordinary authenticated SSH.
gateway_login() {
  local p="${1:-}"
  [[ $# -gt 0 ]] || return 1; shift
  if [[ $# == 0 ]]; then gateway_login_local "$p"; return $?; fi
  [[ $# == 2 && "$1" == --remote ]] || { err 'Usage: spark gateway login PROVIDER [--remote USER@HOST]'; return 1; }
  gateway_login_remote "$p" "$2"
}
gateway_login_remote() (
  local p="$1" target="$2" transfer cleanup file
  gateway_oauth_env "$p" >/dev/null || return 1
  # Keep SSH options and remote command syntax out of user-supplied hostnames.
  [[ "$target" =~ ^[A-Za-z0-9_][A-Za-z0-9_.@:-]*$ ]] || { err 'Use an SSH alias or USER@HOST'; return 1; }
  [[ -z "${SSH_CONNECTION:-}" || "$p" != xai ]] || { err 'Start this command on the computer with your browser'; return 1; }
  docker info >/dev/null 2>&1 || { err 'Local OAuth requires Docker on the computer with the browser'; return 1; }
  docker image inspect "$LITELLM_IMAGE" >/dev/null 2>&1 || docker pull "$LITELLM_IMAGE" >/dev/null || return 1
  mkdir -p "$SPARK_CONFIG_DIR" && chmod 700 "$SPARK_CONFIG_DIR" || return 1
  transfer=$(umask 077; mktemp -d "$SPARK_CONFIG_DIR/oauth-transfer.XXXXXX") || return 1
  printf -v cleanup 'rm -rf -- %q' "$transfer"
  # shellcheck disable=SC2064 # Capture the quoted private path before function scope ends.
  trap "$cleanup" EXIT
  SPARK_CONFIG_DIR="$transfer" gateway_login_local "$p" || return 1
  file="$transfer/oauth/$p/$(gateway_oauth_file "$p")"
  # Never place credentials in command arguments, stdout, or a controller backup.
  ssh -o BatchMode=yes -o ClearAllForwardings=yes -o ForwardAgent=no -o ConnectTimeout=10 "$target" "\"\$HOME/.local/bin/spark\" gateway import-session $p" < "$file" || return 1
  info "OAuth session installed on ${target}; temporary local credentials removed on exit"
)
gateway_import_session() {
  local p="${1:-}" file dir content old='' running=0 mode
  [[ $# == 1 ]] || return 1
  file=$(gateway_oauth_file "$p") || return 1
  content=$(head -c 65537) || return 1
  [[ -n "$content" && ${#content} -le 65536 ]] || { err 'Invalid or oversized OAuth session'; return 1; }
  if [[ "$p" == github_copilot ]]; then
    [[ "$content" =~ ^[A-Za-z0-9_.~+/=-]+$ ]] || return 1
  else
    printf '%s\n' "$content" | jq -e 'type=="object"' >/dev/null || return 1
    if [[ "$p" == xai ]]; then
      printf '%s\n' "$content" | jq -e '(.access_token|type=="string" and length>0) and (.refresh_token|type=="string" and length>0) and (.token_endpoint|type=="string" and startswith("https://auth.x.ai/"))' >/dev/null || return 1
    fi
  fi
  gateway_capabilities "$p" >/dev/null || { err 'Remote LiteLLM image does not support this OAuth provider'; return 1; }
  dir=$(gateway_oauth_dir "$p")
  mkdir -p "$dir" && chmod 700 "$SPARK_CONFIG_DIR" "$SPARK_CONFIG_DIR/oauth" "$dir" || return 1
  mode=$(gateway_load_config | jq -r --arg p "$p" 'if .providers[$p].enabled and .providers[$p].auth=="oauth" then "oauth" else "inactive" end') || return 1
  if [[ "$mode" == oauth ]] && gateway_running_state; then
    running=1
    # Stop refresh workers before reading/replacing credentials from another account.
    docker stop "$GATEWAY_CONTAINER" >/dev/null 2>&1 || { err 'Could not stop OAuth refresh; session left unchanged'; return 1; }
  fi
  [[ ! -f "$dir/$file" ]] || old=$(cat "$dir/$file")
  if ! gateway_session_write "$dir/$file" "$content"; then
    [[ "$running" == 0 ]] || gateway_sync_locked || err 'Could not restart the previous OAuth session'
    return 1
  fi
  [[ "$p" != github_copilot ]] || rm -f "$dir/api-key.json"
  if [[ "$running" == 1 ]] && ! gateway_sync_locked; then
    docker stop "$GATEWAY_CONTAINER" >/dev/null 2>&1 || { err 'Could not stop the replacement session; inspect gateway status'; return 1; }
    if [[ -n "$old" ]]; then gateway_session_write "$dir/$file" "$old" || return 1; else rm -f "$dir/$file"; fi
    gateway_sync_locked || err 'Previous OAuth session could not be restored'
    return 1
  fi
  [[ "$running" == 1 ]] || info "${p} OAuth session installed; enable its models with spark gateway add ${p}"
}
gateway_session_write() {
  local file="$1" content="$2" tmp
  tmp=$(umask 077; mktemp "${file}.tmp.XXXXXX") || return 1
  if printf '%s\n' "$content" > "$tmp" && chmod 600 "$tmp" && mv "$tmp" "$file"; then return 0; fi
  rm -f "$tmp"; return 1
}
# Based on spark by Massimo Angelini - https://github.com/massimo92/spark
# Native LiteLLM virtual keys: persistent hashes, runtime-only administrative key.
gateway_key_hash() { printf '%s' "$1" | shasum -a 256 | awk '{print $1}'; }
gateway_auth_key() {
  # Internal administration only. Never export this to an inference client.
  docker exec "$GATEWAY_CONTAINER" cat /run/spark/master-key 2>/dev/null
}
gateway_auth_ready() {
  gateway_load_config | jq -e '.auth.storage=="virtual-keys" and (.auth.client_hash | type=="string" and test("^[a-f0-9]{64}$")) and (.auth.recovery_required!=true)' >/dev/null
}
gateway_database_name() { printf '%s-db\n' "$GATEWAY_CONTAINER"; }
gateway_database_owner() { printf '%s' "$SPARK_CONFIG_DIR" | shasum -a 256 | awk '{print $1}'; }
gateway_database_remove() {
  local purge="${1:-0}" dry_run="${2:-0}" name owner existing volume
  name=$(gateway_database_name); owner=$(gateway_database_owner)
  if existing=$(docker inspect "$name" --format '{{json .Config.Labels}}' 2>/dev/null); then
    printf '%s' "$existing" | jq -e --arg owner "$owner" '.["io.spark.gateway-owner"]==$owner' >/dev/null || {
      warn 'Leaving a database container owned by another configuration'; return 1;
    }
    if [[ "$dry_run" == 1 ]]; then
      printf '  would remove container %s (database volumes retained unless --purge)\n' "$name"
    else
      docker rm -f "$name" >/dev/null 2>&1 || return 1
    fi
  fi
  [[ "$purge" == 1 ]] || return 0
  for volume in "$name-data" "$name-socket"; do
    existing=$(docker volume inspect "$volume" --format '{{json .Labels}}' 2>/dev/null) || continue
    printf '%s' "$existing" | jq -e --arg owner "$owner" '.["io.spark.gateway-owner"]==$owner' >/dev/null || return 1
    if [[ "$dry_run" == 1 ]]; then printf '  would remove volume %s\n' "$volume"; else docker volume rm "$volume" >/dev/null || return 1; fi
  done
}
gateway_database_prepare() {
  local name owner existing attempt volume
  name=$(gateway_database_name); owner=$(gateway_database_owner)
  if existing=$(docker inspect "$name" --format '{{json .}}' 2>/dev/null); then
    printf '%s\n' "$existing" | jq -e --arg owner "$owner" --arg name "$name" '
      .Config.Labels["io.spark.gateway-owner"]==$owner and .HostConfig.NetworkMode=="none" and
      (.HostConfig.PortBindings // {} | length)==0 and
      any(.Mounts[]; .Name==($name+"-data") and .Destination=="/var/lib/postgresql/data") and
      any(.Mounts[]; .Name==($name+"-socket") and .Destination=="/var/run/postgresql")' >/dev/null || {
      err 'Gateway database container is not privately owned by this configuration'; return 1;
    }
    docker start "$name" >/dev/null 2>&1 || return 1
  else
    for volume in "$name-data" "$name-socket"; do
      if existing=$(docker volume inspect "$volume" --format '{{json .Labels}}' 2>/dev/null); then
        printf '%s\n' "$existing" | jq -e --arg owner "$owner" '.["io.spark.gateway-owner"]==$owner' >/dev/null || { err 'Database volume belongs to another configuration'; return 1; }
      else
        docker volume create --label "io.spark.gateway-owner=$owner" "$volume" >/dev/null || return 1
      fi
    done
    # No TCP listener/network/password file: only the explicitly mounted Unix socket.
    docker run -d --name "$name" --label "io.spark.gateway-owner=$owner" --restart unless-stopped --network none \
      -e POSTGRES_DB=litellm -e POSTGRES_USER=spark -e POSTGRES_HOST_AUTH_METHOD=trust \
      -e 'POSTGRES_INITDB_ARGS=--auth-local=trust --auth-host=reject' \
      -v "$name-data:/var/lib/postgresql/data" -v "$name-socket:/var/run/postgresql" \
      "${SPARK_GATEWAY_POSTGRES_IMAGE:-postgres:17-alpine}" postgres -c 'listen_addresses=' >/dev/null 2>&1 || { err 'Could not start private LiteLLM PostgreSQL'; return 1; }
  fi
  for ((attempt=0; attempt<30; attempt++)); do
    docker exec "$name" pg_isready -q -h /var/run/postgresql -U spark -d litellm >/dev/null 2>&1 && return 0
    sleep 1
  done
  err 'Private LiteLLM PostgreSQL did not become ready'; return 1
}
gateway_database_client_hashes() {
  local hashes
  hashes=$(docker exec "$(gateway_database_name)" psql -X -A -t -v ON_ERROR_STOP=1 -U spark -d litellm -c \
    'SELECT token FROM "LiteLLM_VerificationToken" WHERE user_id = '\''spark-clients'\'' ORDER BY token') || return 1
  printf '%s\n' "$hashes" | jq -Rn '[inputs | select(length>0)] | if all(.[]; test("^[a-f0-9]{64}$")) then . else error("Invalid virtual-key hash") end'
}
gateway_database_migrate() {
  local script
  # Use Prisma's own migrator and socket URL. Some LiteLLM migration coordinators
  # strip libpq's host query parameter and would incorrectly attempt TCP.
  script='import pathlib, subprocess
import litellm_proxy_extras
schema = pathlib.Path(litellm_proxy_extras.__file__).parent / "schema.prisma"
subprocess.run(["prisma", "migrate", "deploy", "--schema", str(schema)], check=True)'
  docker run --rm --network none --user "$(id -u):$(id -g)" -e HOME=/tmp \
    -e 'DATABASE_URL=postgresql://spark@localhost/litellm?host=/var/run/postgresql' \
    -v "$(gateway_database_name)-socket:/var/run/postgresql" --entrypoint python \
    "${GATEWAY_RESTORE_IMAGE:-$LITELLM_IMAGE}" -c "$script" >/dev/null 2>&1 || {
    err 'LiteLLM schema migration over the private PostgreSQL socket failed'; return 1;
  }
}
gateway_admin_post() {
  local path="$1" key payload
