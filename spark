  printf "\n  ${BOLD}Recommended models${NC}\n"
  printf "  Hardware: %s/%s · %s · %s GB %s\n\n" "$SPARK_OS" "$SPARK_ARCH" "$ACCEL" "$pool" "$pool_label"

  if [[ "$BACKEND" == "ollama" ]]; then
