import sys
sys.path.insert(0, "/sandbox/.hermes/plugins/web-spark-ddgs/vendor")
import ddgs
raise SystemExit(0 if importlib.metadata.version("ddgs") == sys.argv[1] else 1)
  ' "$WORKSPACE_HERMES_DDGS_VERSION" >/dev/null 2>&1
