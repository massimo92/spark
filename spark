workspace_install_hermes_ddg_plugin() {
  local plugin_dir="/sandbox/.hermes/plugins/web-spark-ddgs" plugin_code plugin_manifest
  plugin_code='from pathlib import Path
import sys

vendor = str(Path(__file__).parent / "vendor")
if vendor not in sys.path:
    sys.path.insert(0, vendor)

from ddgs import DDGS
import plugins.web.ddgs.provider as upstream


def _duckduckgo_search(query, safe_limit):
    results = []
    with DDGS(timeout=10) as client:
        for index, hit in enumerate(
            client.text(query, max_results=safe_limit, backend="duckduckgo")
        ):
            if index >= safe_limit:
                break
            results.append({
                "title": str(hit.get("title", "")),
                "url": str(hit.get("href") or hit.get("url") or ""),
                "description": str(hit.get("body", "")),
                "position": index + 1,
            })
    return results


def register(ctx):
    upstream._run_ddgs_search = _duckduckgo_search
    ctx.register_web_search_provider(upstream.DDGSWebSearchProvider())'
  plugin_manifest='name: web-spark-ddgs
version: 1.0.0
description: Spark-managed DuckDuckGo provider for NemoClaw
author: Spark
manifest_version: 1
kind: backend
provides_web_providers:
  - ddgs'
  nemohermes hermes exec --no-tty --timeout 20 -- sh -c '
    set -eu
    mkdir -p "$1"
    printf "%s\n" "$2" > "$1/__init__.py"
    printf "%s\n" "$3" > "$1/plugin.yaml"
  ' spark-hermes-ddg-plugin "$plugin_dir" "$plugin_code" "$plugin_manifest" >/dev/null 2>&1 || return 1
  if ! workspace_hermes_ddg_package_ready; then
    nemohermes hermes exec --no-tty --timeout 300 -- \
      /usr/local/bin/uv pip install --link-mode copy \
        --target "${plugin_dir}/vendor" --upgrade \
        "ddgs==${WORKSPACE_HERMES_DDGS_VERSION}" >/dev/null 2>&1 || return 1
  fi
  workspace_hermes_ddg_package_ready
}

workspace_hermes_ddg_search_ready() {
