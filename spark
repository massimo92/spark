  value=$(sed -n '1p' "$file")
  workspace_require_prompt_value "$label" "$value" text
  printf '%s\n' "$value"
}

workspace_env_or_generated() {
  local key="$1" val=""
  val=$(workspace_read_env "$key" 2>/dev/null || true)
  if [[ -n "$val" ]]; then
    printf '%s\n' "$val"
  else
    workspace_random_secret
  fi
}

workspace_env_or_random_password() {
