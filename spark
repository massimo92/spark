workspace_doctor_failed_ids_quiet() {
  local model="$1" old_read_only="${SPARK_WORKSPACE_READ_ONLY:-}" out
  SPARK_WORKSPACE_READ_ONLY=1
  out=$(cmd_workspace_doctor --json --model "$model" 2>/dev/null || true)
