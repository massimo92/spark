# The LiteLLM gateway runs in Docker on both backends. In --check we only verify Docker;
# otherwise we enable this backend's provider (plus optional cloud providers) and start it.
step_gateway() {
  local auto_yes="$1" check_only="$2"
  if ctx_run 'docker info >/dev/null 2>&1'; then
    info "Docker: available for the gateway"
  elif [[ "$check_only" == "1" ]]; then
    setup_fail "Docker not available — the LiteLLM gateway needs it"; return 0
  elif [[ "$TGT_OS" == "Darwin" ]]; then
    setup_manual_step "Install Docker Desktop (the gateway runs in a container): https://docs.docker.com/desktop/"; return 0
  else
    setup_fail "Docker not running — needed for the gateway"; return 0
  fi
  [[ "$check_only" == "1" ]] && return 0

  if [[ "$auto_yes" != "1" ]] && ! confirm "Set up the LiteLLM gateway (unified API for local + cloud models)?"; then
    setup_skip "LiteLLM gateway"; return 0
  fi

  if ctx_run "docker images --format '{{.Repository}}:{{.Tag}}' 2>/dev/null | grep -q 'ghcr.io/berriai/litellm'"; then
    info "LiteLLM image present"
  elif ctx_run "docker pull ${LITELLM_IMAGE}"; then
    info "Pulled ${LITELLM_IMAGE}"
  else
    setup_fail "LiteLLM image pull failed"; return 0
  fi

  local prov="vllm"; [[ "$TGT_BACKEND" == "ollama" ]] && prov="ollama"
  local gw_or=0 gw_zen=0 gw_tg=0 or_key="" zen_key="" tg_key=""
  if [[ "$auto_yes" != "1" ]]; then
    if confirm "Enable OpenRouter? (cloud, needs API key)"; then
      printf "  OpenRouter API key (blank to skip): "; read -rs or_key; printf "\n"; [[ -n "$or_key" ]] && gw_or=1
    fi
    if confirm "Enable Zen / OpenCode? (cloud, needs API key)"; then
      printf "  Zen API key (blank to skip): "; read -rs zen_key; printf "\n"; [[ -n "$zen_key" ]] && gw_zen=1
    fi
    if confirm "Enable Together AI? (cloud, needs API key)"; then
      printf "  Together AI API key (blank to skip): "; read -rs tg_key; printf "\n"; [[ -n "$tg_key" ]] && gw_tg=1
    fi
  fi

  local gw_json
  gw_json=$(jq -n \
    --argjson port "$GATEWAY_PORT" \
    --argjson vllm_en "$( [[ "$prov" == "vllm" ]] && echo true || echo false )" \
    --argjson ollama_en "$( [[ "$prov" == "ollama" ]] && echo true || echo false )" \
    --argjson or_en "$( [[ "$gw_or" == "1" ]] && echo true || echo false )" --arg or_key "$or_key" \
    --argjson zen_en "$( [[ "$gw_zen" == "1" ]] && echo true || echo false )" --arg zen_key "$zen_key" \
    --argjson tg_en "$( [[ "$gw_tg" == "1" ]] && echo true || echo false )" --arg tg_key "$tg_key" \
    '{enabled:true, port:$port, providers:{
        vllm:{enabled:$vllm_en, port:8000},
        ollama:{enabled:$ollama_en},
        openrouter:{enabled:$or_en, api_key:$or_key},
        zen:{enabled:$zen_en, api_key:$zen_key},
        together:{enabled:$tg_en, api_key:$tg_key}
      }}')

  # gateway_save_config writes the controller copy used by gateway_generate_litellm_yaml.
  gateway_save_config "$gw_json"

  if [[ "$SETUP_TARGET" == "remote" ]]; then
    ctx_run 'mkdir -p $HOME/.config/spark'
    printf '%s\n' "$gw_json" | ctx_write_file '$HOME/.config/spark/gateway.json'
    local yaml; yaml="$(gateway_generate_litellm_yaml)"
    [[ -n "$yaml" ]] && printf '%s\n' "$yaml" | ctx_write_file '$HOME/.config/spark/litellm_config.yaml'
    local env_flags=""
    [[ -n "$or_key" ]] && env_flags+=" -e OPENROUTER_API_KEY='${or_key}'"
    [[ -n "$zen_key" ]] && env_flags+=" -e ZEN_API_KEY='${zen_key}'"
    [[ -n "$tg_key" ]] && env_flags+=" -e TOGETHER_API_KEY='${tg_key}'"
    ctx_run "docker rm -f ${GATEWAY_CONTAINER} 2>/dev/null || true"
    if ctx_run "docker run -d --network host -v ~/.config/spark/litellm_config.yaml:/app/config.yaml ${env_flags} --name ${GATEWAY_CONTAINER} --restart unless-stopped ${LITELLM_IMAGE} --config /app/config.yaml --port ${GATEWAY_PORT}"; then
      info "LiteLLM gateway started on :${GATEWAY_PORT}"
    else
      setup_fail "Gateway failed to start"
    fi
  else
    if docker ps --format '{{.Names}}' 2>/dev/null | grep -q "^${GATEWAY_CONTAINER}$"; then
      ( gateway_restart ) >/dev/null 2>&1 && info "Gateway restarted" || warn "Could not restart the gateway"
    else
      ( gateway_start ) && info "LiteLLM gateway started on :${GATEWAY_PORT}" || warn "Start it later: spark gateway start"
    fi
  fi
}

# OS hardening (Linux + systemd) so SSH always has room even if models exhaust RAM:
#   1) early-OOM (earlyoom) kills the memory hog before the kernel deadlocks into swap thrash.
#   2) MemoryMin protects sshd from reclaim so it never gets paged out / starved.
# earlyoom is the emergency backstop. Declarative: reconciles to '-m $EARLYOOM_MIN_FREE_PCT -s 100'
# regardless of any old/divergent config (e.g. a -m 8 / -m 3 left from experiments).
step_earlyoom() {
  local auto_yes="$1" check_only="$2" want="$EARLYOOM_MIN_FREE_PCT" installed=0 active=0 cur_m
  local ef="${EARLYOOM_DEFAULT_FILE:-/etc/default/earlyoom}"
  ctx_run 'command -v earlyoom >/dev/null 2>&1' && installed=1
  ctx_run 'systemctl is-active --quiet earlyoom' && active=1
  cur_m="$(ctx_run "grep -oE -- '-m[ =][0-9]+' '$ef' 2>/dev/null | grep -oE '[0-9]+' | head -1")"
  if [[ "$installed" == "1" && "$active" == "1" && "$cur_m" == "$want" ]]; then
    info "early-OOM: earlyoom active (-m ${want}%, reclaim-protected backstop)"
    return 0
  fi
  if [[ "$check_only" == "1" ]]; then
    if [[ "$installed" != "1" ]]; then setup_fail "early-OOM not active — install earlyoom so a runaway model is killed before the box freezes"
    else setup_fail "earlyoom not at -m ${want}% (found '${cur_m:-none}') — re-run spark setup to reconcile"; fi
    return 0
  fi
  printf "    ${DIM}What: install/configure 'earlyoom' (-m ${want}%%): kill the memory hog when free RAM is low.\n"
  printf "    Why: it kills the offending model EARLY, while there's still free RAM, before the machine\n"
  printf "    bogs down and locks you out. The cgroup cap + admission keep normal use far from this floor.${NC}\n"
  if [[ "$auto_yes" == "1" ]] || confirm "Install/repair earlyoom at -m ${want}%?"; then
    if [[ "$installed" != "1" ]] && ! ctx_sudo 'apt-get update >/dev/null 2>&1 && apt-get install -y earlyoom >/dev/null 2>&1'; then
      setup_fail "Could not install earlyoom (apt)"; return 0
    fi
    printf 'EARLYOOM_ARGS="-m %s -s 100 --avoid '\''(^|/)(systemd|sshd?|ssh|dbus)$'\'' --prefer '\''(^|/)(vllm|python|pt_main_thread)$'\''"\n' "$want" | ctx_sudo_write "$ef"
    if ctx_sudo 'systemctl enable --now earlyoom >/dev/null 2>&1; systemctl restart earlyoom'; then
      info "early-OOM: earlyoom set to -m ${want}%"
    else
      setup_fail "Could not enable earlyoom"
    fi
  else
    setup_skip "early-OOM (earlyoom)"
  fi
}

# Protect SSH so you can ALWAYS connect: MemoryMin (reclaim-protected, stays responsive) +
# OOMScoreAdjust=-1000 (the OOM killer never picks sshd). Declarative single drop-in, idempotent.
step_sshd_memorymin() {
  local auto_yes="$1" check_only="$2" unit mm oom
  unit="$(ctx_run 'systemctl list-unit-files --no-legend ssh.service sshd.service 2>/dev/null | awk "NR==1{print \$1}"')"
  [[ -z "$unit" ]] && unit="ssh.service"
  mm="$(ctx_run "systemctl show -p MemoryMin --value ${unit} 2>/dev/null")"
  oom="$(ctx_run "systemctl show -p OOMScoreAdjust --value ${unit} 2>/dev/null")"
  if [[ "$mm" == "536870912" && "$oom" == "-1000" ]]; then
    info "sshd: ${unit} MemoryMin=512M + OOMScoreAdjust=-1000 (always reachable)"
    return 0
  fi
  if [[ "$check_only" == "1" ]]; then
    setup_fail "sshd not fully protected (MemoryMin/OOMScoreAdjust) — it can be starved or OOM-killed"
    return 0
  fi
  printf "    ${DIM}What: reserve 512 MB for sshd and make it OOM-immune (drop-in on ${unit}).\n"
  printf "    Why: under memory pressure sshd stays resident AND the OOM killer never targets it, so\n"
  printf "    you can always connect to fix things. Restarting ssh is safe (your session survives).${NC}\n"
  if [[ "$auto_yes" == "1" ]] || confirm "Protect ${unit} (MemoryMin + OOM-immune)?"; then
    ctx_sudo "mkdir -p /etc/systemd/system/${unit}.d"
    printf '[Service]\nMemoryAccounting=yes\nMemoryMin=512M\nOOMScoreAdjust=-1000\n' | ctx_sudo_write "/etc/systemd/system/${unit}.d/10-spark-memory.conf"
    ctx_sudo 'systemctl daemon-reload'
    if ctx_sudo "systemctl reload ${unit} || systemctl restart ${unit}"; then
      info "sshd: ${unit} MemoryMin=512M + OOMScoreAdjust=-1000 set"
    else
      setup_fail "Could not protect ${unit}"
    fi
  else
    setup_skip "sshd protection"
  fi
}

# Disable host swap so a memory spike can't thrash the box (the original freeze cause). With no swap
# the kernel OOM-kills promptly instead of thrashing forever. Declarative + idempotent.
step_swapoff() {
  local auto_yes="$1" check_only="$2" swap_on
  swap_on="$(ctx_run 'swapon --show=NAME --noheadings 2>/dev/null | head -1' 2>/dev/null)"
  if [[ -z "$swap_on" ]]; then
    info "Swap: off (no thrash risk)"
    return 0
  fi
  if [[ "$check_only" == "1" ]]; then
    setup_fail "Swap is on — a memory spike can thrash the box; spark setup disables it"
    return 0
  fi
  printf "    ${DIM}What: turn off swap (swapoff -a) and comment swap lines in /etc/fstab.\n"
  printf "    Why: if RAM fills up, swap pages memory out to disk — the whole machine crawls and can\n"
  printf "    stop answering SSH for minutes. With no swap the kernel instead kills just the over-using\n"
  printf "    process at once and the box stays responsive. Inference servers run swapless.${NC}\n"
  if [[ "$auto_yes" == "1" ]] || confirm "Disable swap now and persist it?"; then
    ctx_sudo 'swapoff -a'
    ctx_sudo "sed -ri.spark-bak 's@^([^#].*[[:space:]]swap[[:space:]])@#\\1@' /etc/fstab"
    if [[ -z "$(ctx_run 'swapon --show=NAME --noheadings 2>/dev/null | head -1' 2>/dev/null)" ]]; then
      info "Swap: disabled"
    else
      setup_fail "Could not disable swap"
    fi
  else
    setup_skip "Swap off"
  fi
}

# The one install set — identical software whether the target is local or remote.
