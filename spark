    [[ "$(grep -c 'pids_limit:' "$WORKSPACE_COMPOSE_FILE" 2>/dev/null || true)" -ge "$minimum" ]] &&
    [[ "$(grep -c 'max-size: "10m"' "$WORKSPACE_COMPOSE_FILE" 2>/dev/null || true)" -ge "$minimum" ]] &&
