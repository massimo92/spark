# Keep the operator's image pin outside the replaceable CLI. Read data, not shell.
spark_load_litellm_image_pin() {
  local file="${SPARK_CONFIG_DIR}/litellm-image" pin
  [[ -e "$file" || -L "$file" ]] || return 0
  if [[ ! -f "$file" || ! -r "$file" ]] || ! pin=$(cat "$file"); then
    printf 'Cannot read LiteLLM image pin: %s\n' "$file" >&2
    return 1
  fi
  if [[ ! "$pin" =~ ^[a-z0-9][a-z0-9._:/-]*@sha256:[0-9a-f]{64}$ ]]; then
    printf 'Invalid LiteLLM image pin in %s: expected repository@sha256:<64 hex digits>\n' "$file" >&2
    return 1
  fi
  LITELLM_IMAGE="$pin"
}
# shellcheck disable=SC2317 # return when sourced, exit when executed
