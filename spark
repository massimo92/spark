    printf "\n  URLs: Vikunja=%s n8n=%s Hermes=%s\n" "${vikunja_url:-unset}" "${n8n_url:-unset}" "${hermes_url:-unset}"
    printf "  Tailscale: %s\n" "${tailscale_mode:-unset}"
  fi
  cmd_workspace_health
