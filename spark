workspace_hermes_sandbox_policy_ready() {
  local policy
  command -v jq >/dev/null 2>&1 || return 1
  command -v openshell >/dev/null 2>&1 || return 1
  policy=$(openshell policy get hermes --base -o json 2>/dev/null) || return 1
  printf '%s\n' "$policy" | jq -e '
    ((.policy.filesystem_policy.read_write // []) | index("/var/tmp")) != null and
    ((.policy.network_policies["spark-hermes-ddg"].binaries // []) |
      any(.path == "/usr/bin/python3*")) and
    ((.policy.network_policies["spark-hermes-ddg"].binaries // []) |
      any(.path == "/opt/hermes/.venv/bin/python*")) and
    ((.policy.network_policies["spark-hermes-ddg"].endpoints // []) |
      any(.host == "html.duckduckgo.com" and .port == 443 and .protocol == "rest")) and
    ((.policy.network_policies["spark-hermes-pypi"].binaries // []) |
      any(.path == "/usr/local/bin/uv")) and
    ((.policy.network_policies["spark-hermes-pypi"].endpoints // []) |
      any(.host == "pypi.org" and .port == 443 and .protocol == "rest")) and
    ((.policy.network_policies["spark-hermes-pypi"].endpoints // []) |
      any(.host == "files.pythonhosted.org" and .port == 443 and .protocol == "rest"))
  ' >/dev/null 2>&1
}

workspace_reconcile_hermes_sandbox_policy() {
  local policy_file rc=0
  command -v jq >/dev/null 2>&1 || return 1
  command -v openshell >/dev/null 2>&1 || return 1
  workspace_hermes_sandbox_policy_ready && return 0
  policy_file=$(mktemp "${TMPDIR:-/tmp}/spark-hermes-policy.XXXXXX") || return 1
  if ! openshell policy get hermes --base -o json 2>/dev/null | jq '
    .policy
    | .filesystem_policy.read_write =
        (((.filesystem_policy.read_write // []) + ["/var/tmp"]) | unique)
    | .network_policies = (.network_policies // {})
    | .network_policies["spark-hermes-ddg"] = {
        name: "spark-hermes-ddg",
        binaries: [
          {path: "/usr/bin/python3*"},
          {path: "/opt/hermes/.venv/bin/python*"}
        ],
        endpoints: [{
          host: "html.duckduckgo.com",
          port: 443,
          protocol: "rest",
          enforcement: "enforce",
          rules: [
            {allow: {method: "POST", path: "/html/"}},
            {allow: {method: "POST", path: "/html/**"}}
          ]
        }]
      }
    | .network_policies["spark-hermes-pypi"] = {
        name: "spark-hermes-pypi",
        binaries: [{path: "/usr/local/bin/uv"}],
        endpoints: [
          {
            host: "pypi.org",
            port: 443,
            protocol: "rest",
            enforcement: "enforce",
            rules: [{allow: {method: "GET", path: "/simple/**"}}]
          },
          {
            host: "files.pythonhosted.org",
            port: 443,
            protocol: "rest",
            enforcement: "enforce",
            rules: [{allow: {method: "GET", path: "/**"}}]
          }
        ]
      }
  ' > "$policy_file"; then
    rc=1
  elif ! openshell policy set hermes --policy "$policy_file" --wait >/dev/null 2>&1; then
    rc=1
  fi
  rm -f "$policy_file"
  [[ "$rc" -eq 0 ]] && workspace_hermes_sandbox_policy_ready
}

workspace_hermes_ddg_package_ready() {
