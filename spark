gateway_stop() {
  if ! docker ps --format '{{.Names}}' 2>/dev/null | grep -q "^${GATEWAY_CONTAINER}$"; then
    warn "No running gateway container"
    return 0
  fi

  docker stop "$GATEWAY_CONTAINER" >/dev/null 2>&1
  docker rm "$GATEWAY_CONTAINER" >/dev/null 2>&1 || true
  info "Stopped gateway"
}

gateway_logs() {
  local follow=0
  [[ "${1:-}" == "-f" ]] && follow=1

  if ! docker ps -a --format '{{.Names}}' 2>/dev/null | grep -q "^${GATEWAY_CONTAINER}$"; then
    die "No gateway container found"
  fi

  if [[ "$follow" == "1" ]]; then
    docker logs -f "$GATEWAY_CONTAINER"
  else
    docker logs "$GATEWAY_CONTAINER"
  fi
}
# Based on spark by Massimo Angelini - https://github.com/massimo92/spark

# Client metadata observed for these specific routes. The running backend wins
# for deployment limits and features that can be changed at launch.
gateway_model_client_info() {
  case "$1" in
    vllm/Saren/Qwen3.8-Flash-Next-W4A16-AutoRound-hybrid)
      printf '%s\n' '{"spark_reasoning_efforts":{"off":null,"low":"low","medium":"medium","xhigh":"xhigh"},"spark_dsh_compat":{"supportsDeveloperRole":false,"thinkingFormat":"chat-template","chatTemplateKwargs":{"enable_thinking":{"$var":"thinking.enabled"},"reasoning_effort":{"$var":"thinking.effort","omitWhenOff":true},"preserve_thinking":true}}}'
      ;;
    chatgpt/gpt-6-astra|chatgpt/gpt-6.1-sol|chatgpt/gpt-6-luna)
      local context=272000
      [[ "$1" != chatgpt/gpt-6.1-sol ]] || context=500000
      printf '{"spark_context_window":%s,"max_input_tokens":%s,"supports_vision":true,"spark_reasoning_efforts":{"low":"low","medium":"medium","high":"high","xhigh":"xhigh","max":"max"},"spark_dsh_compat":{"supportsMaxOutputTokens":false}}\n' "$context" "$context"
      ;;
    *) printf '{}\n' ;;
  esac
}

gateway_vllm_model_info() {
  local container="$1" model="$2" runtime profile known artifact
  runtime=$(docker inspect --format '{{json .Config}}' "$container" 2>/dev/null || true)
  known=$(gateway_model_client_info "vllm/$model") || return 1
  artifact=$(jq -r '.Labels["spark.bundle.artifact"] // empty' <<<"$runtime" 2>/dev/null || true)
  [[ "$artifact" =~ ^[a-zA-Z0-9._-]+$ ]] || artifact=""
  profile=$(BUNDLE_ARTIFACT_KEY="$artifact" profile_file_for "$model")
  profile=$(jq -ce 'select(type == "object")' "$profile" 2>/dev/null || printf '{}')
  printf '%s\n' "$runtime" | jq -c --argjson profile "$profile" --argjson known "$known" '
    def value($flag):
      . as $args | [range(0; length) as $i |
        if $args[$i] == $flag then $args[$i+1]
        elif $args[$i] | startswith($flag + "=") then $args[$i] | split("=")[1:] | join("=")
        else empty end] | last;
    def positive: tonumber? | select(. > 0 and . == floor);
    def runtime_length:
      if type == "string" and test("^[0-9]+([.][0-9]+)?[kKmM]$") then
        (.[:-1] | tonumber) *
          (if endswith("k") then 1000 elif endswith("K") then 1024
           elif endswith("m") then 1000000 else 1048576 end) | floor
      else positive end;
    (.Cmd // []) as $args |
    ([($args | value("--max-model-len") | runtime_length),
      (.Labels["spark.max_model_len"] | positive)] | first) as $context |
    ($args | value("--limit-mm-per-prompt") | fromjson? // {}) as $media |
    ($args | value("--reasoning-parser")) as $parser |
    ($args | value("--reasoning-effort-map") | fromjson? // {}) as $efforts |
    ($args | value("--override-generation-config") | fromjson? // {}) as $generation |
    ([$generation.max_new_tokens,
      (if ($args | value("--generation-config")) as $source | $source == null or $source == "auto"
       then $profile.hf.raw.generation_config.max_new_tokens else null end)] | map(positive) | first) as $output |
    (if $context != null and $output != null then [$context, $output] | min else $output end) as $output_limit |
    {mode:"chat",
     spark_context_window:$context,
     max_input_tokens:$context,
     max_output_tokens:$output_limit,
     spark_max_output_tokens:$output_limit,
     supports_vision:(if $media.image == 0 or (($media.image | objects | .count) // -1) == 0 then false
       elif .Labels["spark.is_multimodal"] == "true" then true
       elif .Labels["spark.is_multimodal"] == "false" then false
       else ($profile.is_multimodal | if . == "true" then true
         elif . == "false" then false else . end) end),
     supports_function_calling:(($args | index("--enable-auto-tool-choice")) != null and
       ($args | value("--tool-call-parser")) != null)}
    + ($known | if $parser == null then del(.spark_reasoning_efforts) else . end)
    + (if ($efforts | type) == "object" and $parser != null and ($known | has("spark_reasoning_efforts") | not)
       then ($efforts | keys | map(select(test("^(minimal|low|medium|high|xhigh|max)$"))) |
         map({key:.,value:.}) | from_entries |
         if length > 0 then {spark_reasoning_efforts:.} else {} end)
       else {} end)
    | with_entries(select(.value != null))
  ' 2>/dev/null | awk 'NF { print; found=1 } END { if (!found) print "{\"mode\":\"chat\"}" }'
}

gateway_ollama_model_info() {
  local model="$1" runtime details
  runtime=$(curl -fsS --max-time 2 http://127.0.0.1:11434/api/ps 2>/dev/null || printf '{}')
  details=$(jq -nc --arg model "$model" '{model:$model}' |
    curl -fsS --max-time 2 -H 'Content-Type: application/json' -d @- \
      http://127.0.0.1:11434/api/show 2>/dev/null || printf '{}')
  jq -nc --arg model "$model" --argjson runtime "$runtime" --argjson details "$details" '
    ($runtime.models // [] | map(select(.name == $model or .name == ($model + ":latest"))) |
      first | .context_length | select(type == "number" and . > 0)) as $context |
    {mode:"chat",spark_context_window:$context,max_input_tokens:$context}
    + (if $details.capabilities | type == "array" then
        {supports_vision:($details.capabilities | index("vision") != null),
         supports_function_calling:($details.capabilities | index("tools") != null)}
       else {} end)
  ' | awk 'NF { print; found=1 } END { if (!found) print "{\"mode\":\"chat\"}" }'
}
# Based on spark by Massimo Angelini - https://github.com/massimo92/spark
# Credentials stay outside generated JSON/YAML and never enter status output.
gateway_secrets_path() { printf '%s/gateway.env\n' "$SPARK_CONFIG_DIR"; }
gateway_env_get() {
  local key="$1" file="${2:-$(gateway_secrets_path)}"
  [[ -f "$file" ]] || return 1
  awk -v key="$key" 'index($0,key "=")==1 {print substr($0,length(key)+2); exit}' "$file"
}
gateway_env_set() {
  local key="$1" value="$2" file="${3:-$(gateway_secrets_path)}" tmp
  [[ "$key" =~ ^[A-Z][A-Z0-9_]*$ && "$value" != *$'\n'* && "$value" != *$'\r'* ]] || return 1
  mkdir -p "$SPARK_CONFIG_DIR" && chmod 700 "$SPARK_CONFIG_DIR" || return 1
  tmp=$(umask 077; mktemp "${file}.tmp.XXXXXX") || return 1
  if [[ -f "$file" ]]; then awk -v key="$key" 'index($0,key "=")!=1' "$file" > "$tmp"; fi
  printf '%s=%s\n' "$key" "$value" >> "$tmp"
  chmod 600 "$tmp" && mv "$tmp" "$file"
}
gateway_auth_terminal() { [[ -t 2 ]]; }
gateway_auth_present_new() {
  # Only receive freshly generated keys. Never reveal an existing stored key.
  if gateway_auth_terminal; then
    printf '\nNew LiteLLM token (shown once):\n%s\nSave it now in your password manager. Lost token? Run spark gateway auth rotate.\n\n' "$1" >&2
  else
    printf 'New LiteLLM client key created; only its hash is saved, no token displayed without an interactive terminal. Run spark gateway auth rotate in a terminal (ssh -t for a remote command) to generate a replacement.\n' >&2
  fi
}
gateway_auth_ensure() {
  local key p env_key config migrated=0 ollama_models
  # Provider secrets remain private; inference credentials live only as DB hashes.
  mkdir -p "$SPARK_CONFIG_DIR" && chmod 700 "$SPARK_CONFIG_DIR" || return 1
  if [[ ! -f "$(gateway_secrets_path)" ]]; then (umask 077; touch "$(gateway_secrets_path)") || return 1; fi
  config=$(gateway_load_config) || return 1
  [[ ! -L "$SPARK_CONFIG_DIR/gateway-migration" ]] || { err 'Recovery folder must not be a symlink'; return 1; }
  # Keep credentials recoverable until the new gateway or a rollback is verified.
  if [[ ! -d "$SPARK_CONFIG_DIR/gateway-migration" ]] && { [[ -f "$GATEWAY_CONFIG" ]] && grep -q '"api_key"' "$GATEWAY_CONFIG"; }; then
    (umask 077
      mkdir "$SPARK_CONFIG_DIR/gateway-migration" &&
      cp "$GATEWAY_CONFIG" "$SPARK_CONFIG_DIR/gateway-migration/gateway.json" &&
      cp "$(gateway_secrets_path)" "$SPARK_CONFIG_DIR/gateway-migration/gateway.env" &&
      { [[ ! -f "$SPARK_CONFIG_DIR/litellm_config.yaml" ]] || cp "$SPARK_CONFIG_DIR/litellm_config.yaml" "$SPARK_CONFIG_DIR/gateway-migration/litellm_config.yaml"; }
    ) || return 1
  fi
  # Migrate old provider keys without displaying or passing them to Docker argv.
  for p in openrouter zen together openai xai anthropic; do
    env_key=$(gateway_provider_env "$p")
    key=$(printf '%s\n' "$config" | jq -r --arg p "$p" '.providers[$p].api_key // ""')
    if [[ -n "$key" ]]; then gateway_env_set "$env_key" "$key" || return 1; migrated=1; fi
  done
  if [[ "$migrated" == 1 ]]; then
    config=$(printf '%s\n' "$config" | jq 'del(.providers[].api_key)') || return 1
    gateway_save_config "$config" || return 1
  fi
  # Adopt a legacy wildcard installation once; explicit stop registries stay empty.
  if [[ "$(printf '%s\n' "$config" | jq -r '.providers.ollama.enabled // false')" == true ]] && ! printf '%s\n' "$config" | jq -e '.providers.ollama | has("models")' >/dev/null; then
    ollama_models=$({ ollama ps 2>/dev/null | awk 'NR>1{print $1}' || true;
      printf '%s\n' "$config" | jq -r 'select(.main.provider=="ollama") | .main.model // empty';
    } | jq -Rn '[inputs | select(length>0)] | unique') || return 1
    config=$(printf '%s\n' "$config" | jq --argjson models "$ollama_models" '.providers.ollama.models=$models') || return 1
    gateway_save_config "$config" || return 1
  fi
  chmod 600 "$(gateway_secrets_path)"
}
gateway_with_lock() (
  local lock="${SPARK_CONFIG_DIR}/gateway.lock" attempt cleanup_command
  mkdir -p "$SPARK_CONFIG_DIR" && chmod 700 "$SPARK_CONFIG_DIR" || exit 1
  for ((attempt=0; attempt<30; attempt++)); do
    if mkdir "$lock" 2>/dev/null; then break; fi
    local owner
    owner=$(cat "$lock/pid" 2>/dev/null || true)
    if [[ "$owner" =~ ^[0-9]+$ ]] && ! kill -0 "$owner" 2>/dev/null; then
      rm -f "$lock/pid"; rmdir "$lock" 2>/dev/null || true
    fi
    sleep 1
  done
  [[ "$attempt" -lt 30 ]] || { err 'Gateway busy; retry when the other command finishes'; exit 1; }
  printf '%s\n' "${BASHPID:-$$}" > "$lock/pid"
  # Capture the escaped path now: local variables can unwind before EXIT fires.
  # shellcheck disable=SC2064
  printf -v cleanup_command 'rm -f -- %q/pid; rmdir -- %q 2>/dev/null || true' "$lock" "$lock"
  # shellcheck disable=SC2064
  trap "$cleanup_command" EXIT
  "$@"
)
gateway_provider_env() {
  case "$1" in
    openrouter) printf OPENROUTER_API_KEY ;; zen) printf ZEN_API_KEY ;;
    together) printf TOGETHER_API_KEY ;; openai) printf OPENAI_API_KEY ;;
    xai) printf XAI_API_KEY ;; anthropic) printf ANTHROPIC_API_KEY ;;
    *) return 1 ;;
  esac
}
gateway_provider_valid() {
  case "$1" in vllm|ollama|openrouter|zen|together|openai|chatgpt|github_copilot|xai|anthropic) return 0 ;; *) return 1 ;; esac
